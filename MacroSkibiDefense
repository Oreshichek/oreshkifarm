local function removeDuplicates(arr)
    if type(arr) ~= "table" then return {} end
    local seen = {}
    local result = {}
    for i = 1, #arr do
        local v = arr[i]
        if v ~= nil and not seen[v] then
            seen[v] = true
            result[#result + 1] = v
        end
    end
    return result
end

local function rand(a, b)
    return a + math.random() * (b - a)
end

local function humanDelay(base, spread)
    local d = base + rand(-spread, spread)
    if d < 0.01 then d = 0.01 end
    task.wait(d)
end

local function sanitize(name)
    name = tostring(name or ""):gsub("[^%w%-%_]", "_"):gsub("_+", "_")
    return name:sub(1, 48)
end

local function cframeToArray(cf) return { cf:GetComponents() } end

local function arrayToCFrame(arr)
    if type(arr) ~= "table" or #arr < 12 then return nil end
    return CFrame.new(table.unpack(arr, 1, 12))
end

