local function placeCF(t)
    local m  = towerModel(t.Name, 2)
    local bp = t:GetAttribute("BoostPos")
    if typeof(bp) == "Vector3" then
        local rot = CFrame.identity
        if m and m:IsA("Model") then
            local ok, pv = pcall(m.GetPivot, m)
            if ok then rot = pv.Rotation end
        end
        return CFrame.new(bp + Vector3.new(0, 4.7, 0)) * rot
    end
    if m and m:IsA("Model") then
        local ok, pv = pcall(m.GetPivot, m)
        if ok then return pv end
    end
    return nil
end

local function badTarget(mode)
    if mode == nil then return true end
    local n = tostring(mode):upper():gsub("%s+", "")
    return n == "" or n == "N/A" or n == "NA" or n == "NONE"
end


local StopRecording

local function attachTower(tower, handle)
    if State.TowerMeta[tower] then return end
    local meta = {
        Handle = handle,
        Level = tonumber(tower:GetAttribute("Upgrade")) or 0,
        Sell = tonumber(tower:GetAttribute("SellPrice")) or 0,
        PendCost = nil,
        TargetMode = tower:GetAttribute("TargetMode"),
        LastUp = -math.huge,
        AbilityMarkers = {},
        LastAbilityAction = nil,
        LastAbilityAt = -math.huge,
        ClockBoost = tower:GetAttribute("ClockBoost"),
        LastBoostSrc = nil,
        LastBoostAt = -math.huge,
        PlaceRecorded = false,
    }
    for a, v in pairs(tower:GetAttributes()) do
        if tostring(a):match("^ATTACK") then meta.AbilityMarkers[a] = v end
    end
    State.TowerMeta[tower] = meta

    addConn(State.RecorderConnections, tower:GetAttributeChangedSignal("SellPrice"):Connect(function()
        local np = tonumber(tower:GetAttribute("SellPrice")) or meta.Sell
        if np > meta.Sell then
            meta.PendCost = math.max(0, (np - meta.Sell) * 2)
            meta.LastUp = os.clock()
        end
        meta.Sell = np
    end))

    addConn(State.RecorderConnections, tower:GetAttributeChangedSignal("Upgrade"):Connect(function()
        local nl = tonumber(tower:GetAttribute("Upgrade")) or meta.Level
        if State.Recording and nl > meta.Level then
            meta.LastUp = os.clock()
            table.insert(State.Actions, {
                Type = "Upgrade", Handle = meta.Handle,
                FromLevel = meta.Level, ToLevel = nl,
                EstimatedCost = meta.PendCost or 0,
                Wave = getWave(), RecordedAt = os.clock() - State.RecordStartedAt,
            })
        end
        meta.Level = nl
        meta.PendCost = nil
    end))

    addConn(State.RecorderConnections, tower:GetAttributeChangedSignal("TargetMode"):Connect(function()
        local nm = tower:GetAttribute("TargetMode")
        local om = meta.TargetMode
        local auto = badTarget(om) and os.clock() - meta.LastUp <= 0.5
        if State.Recording and nm and nm ~= om and not auto then
            table.insert(State.Actions, {
                Type = "Target", Handle = meta.Handle, Mode = nm,
                Wave = getWave(), RecordedAt = os.clock() - State.RecordStartedAt,
            })
        end
        meta.TargetMode = nm
    end))

    addConn(State.RecorderConnections, tower:GetAttributeChangedSignal("ClockBoost"):Connect(function()
        local ns = tower:GetAttribute("ClockBoost")
        local os_ = meta.ClockBoost
        meta.ClockBoost = ns
        if not State.Recording or ns == nil
            or tostring(ns) == "" or tostring(ns) == "0"
            or tostring(ns) == tostring(os_) then return end
        local srcTower = TowerDataFolder:FindFirstChild(tostring(ns))
        if not srcTower then return end
        local srcMeta = State.TowerMeta[srcTower]
        if not srcMeta then return end
        if not srcMeta.PlaceRecorded or not meta.PlaceRecorded then return end
        if meta.LastBoostSrc == srcMeta.Handle and os.clock() - meta.LastBoostAt <= 0.5 then return end
        meta.LastBoostSrc = srcMeta.Handle
        meta.LastBoostAt = os.clock()
        table.insert(State.Actions, {
            Type = "BoostLink", SourceHandle = srcMeta.Handle, TargetHandle = meta.Handle,
            Wave = getWave(), RecordedAt = os.clock() - State.RecordStartedAt,
        })
    end))

    addConn(State.RecorderConnections, tower.AttributeChanged:Connect(function(attr)
        if not tostring(attr):match("^ATTACK") then return end
        local prev = meta.AbilityMarkers[attr]
        local val = tower:GetAttribute(attr)
        meta.AbilityMarkers[attr] = val
        if not State.Recording then return end
        if os.clock() - State.PendingAbilityClickAt > 2 then return end
        if prev == val then return end

        local markerIndex = tonumber(tostring(attr):match("(%d+)$"))
        local abilityIndex = markerIndex or State.PendingAbilityIndex or 1
        State.PendingAbilityClickAt = -math.huge
        State.PendingAbilityIndex = 1

        local now = os.clock()
        local last = meta.LastAbilityAction
        if last and last.Marker == attr and now - meta.LastAbilityAt <= 0.35 then
            last.AbilityIndex = abilityIndex
            meta.LastAbilityAt = now
            return
        end

        local action = {
            Type = "Ability", Handle = meta.Handle,
            TowerId = tostring(tower.Name),
            AbilityIndex = abilityIndex, Marker = attr,
            Wave = getWave(), RecordedAt = now - State.RecordStartedAt,
        }
        meta.LastAbilityAction = action
        meta.LastAbilityAt = now
        table.insert(State.Actions, action)
    end))
end

local function startRecording(profileName)
    if State.Playing then return false, "stop playback first" end
    if not matchReady() then return false, "enter match first" end
    profileName = sanitize(profileName)
    if profileName == "" then return false, "empty name" end

    disconnectAll(State.RecorderConnections)
    State.Actions = {}
    State.ProfileName = profileName
    State.ProfileVersion = 4
    State.RecordStartedAt = os.clock()
    State.NextHandle = 1
    State.TowerMeta = setmetatable({}, { __mode = "k" })
    State.PendingAbilityClickAt = -math.huge
    State.PendingAbilityIndex = 1
    State.Recording = true
    State.RecordSession = State.RecordSession + 1

    addConn(State.RecorderConnections, TowerDataFolder.ChildAdded:Connect(function(t)
        task.spawn(function()
            if not waitUntil(function() return own(t) and t:GetAttribute("ID") ~= nil end, 5, 0.05) then return end
            if not State.Recording then return end
            local h = "T" .. State.NextHandle
            State.NextHandle = State.NextHandle + 1
            attachTower(t, h)
            local cf = placeCF(t)
            if not cf then return end
            local sell = tonumber(t:GetAttribute("SellPrice")) or 0
            table.insert(State.Actions, {
                Type = "Place", Handle = h, Unit = tostring(t:GetAttribute("ID")),
                CFrame = cframeToArray(cf), EstimatedCost = sell * 2,
                Wave = getWave(), RecordedAt = os.clock() - State.RecordStartedAt,
            })
            local m = State.TowerMeta[t]
            if m then m.PlaceRecorded = true end
        end)
    end))

    addConn(State.RecorderConnections, TowerDataFolder.ChildRemoved:Connect(function(t)
        local m = State.TowerMeta[t]
        if not m then return end
        task.delay(0.15, function()
            if State.Recording and not gameEnded() then
                table.insert(State.Actions, {
                    Type = "Sell", Handle = m.Handle,
                    Wave = getWave(), RecordedAt = os.clock() - State.RecordStartedAt,
                })
            end
        end)
    end))

    local ge = getGui() and getGui():FindFirstChild("GameEnded")
    if ge then
        addConn(State.RecorderConnections, ge:GetPropertyChangedSignal("Enabled"):Connect(function()
            if State.Recording and ge.Enabled then
                task.defer(function()
                    if State.Recording then StopRecording(true) end
                end)
            end
        end))
    end
    return true
end

StopRecording = function(save)
    if not State.Recording then return false, "not recording" end
    State.Recording = false
    State.RecordSession = State.RecordSession + 1
    disconnectAll(State.RecorderConnections)
    if save then
        local ok, msg = saveProfile(State.ProfileName)
        if not ok then return false, msg end
    end
    return true
end


local function resolveH(h)
    local t = State.RuntimeHandles[h]
    if t and t.Parent == TowerDataFolder then return t end
    return nil
end

local function findRuntime(action)
    if not TowerDataFolder then return nil end
    for _, t in ipairs(TowerDataFolder:GetChildren()) do
        if own(t) and not State.UsedRuntimeTowers[t]
            and tostring(t:GetAttribute("ID")) == tostring(action.Unit) then
            return t
        end
    end
    return nil
end

local function playPlace(action)
    local cf = arrayToCFrame(action.CFrame)
    if not cf then return true end
    local ex = findRuntime(action)
    if ex then
        State.RuntimeHandles[action.Handle] = ex
        State.UsedRuntimeTowers[ex] = true
        return true
    end
    local cost = tonumber(action.EstimatedCost) or 0
    local deadline = os.clock() + 180
    while State.Playing and os.clock() < deadline and not gameEnded() do
        ex = findRuntime(action)
        if ex then
            State.RuntimeHandles[action.Handle] = ex
            State.UsedRuntimeTowers[ex] = true
            return true
        end
        if getMoney() >= cost then
            if Remotes.Place then
                local jitter = Vector3.new(rand(-0.3, 0.3), 0, rand(-0.3, 0.3))
                pcall(function() Remotes.Place:FireServer(action.Unit, cf + jitter, false) end)
                local ok, tower = waitUntil(function() return findRuntime(action) end, 3, 0.1)
                if ok and tower then
                    State.RuntimeHandles[action.Handle] = tower
                    State.UsedRuntimeTowers[tower] = true
                    return true
                end
            end
        end
        humanDelay(0.9, 0.4)
    end
    return true
end

local function playUpgrade(action)
    local t = resolveH(action.Handle)
    if not t then return true end
    local target = tonumber(action.ToLevel) or ((tonumber(action.FromLevel) or 0) + 1)
    local cost = tonumber(action.EstimatedCost) or 0
    local deadline = os.clock() + 180
    local unlocked = cost <= 0
    while State.Playing and t.Parent == TowerDataFolder and os.clock() < deadline and not gameEnded() do
        local lvl = tonumber(t:GetAttribute("Upgrade")) or 0
        if lvl >= target then return true end
        if not unlocked and getMoney() >= cost then unlocked = true end
        if unlocked and Remotes.Upgrade then
            local before = lvl
            pcall(function() Remotes.Upgrade:FireServer(tostring(t.Name)) end)
            local ok = waitUntil(function()
                return t.Parent ~= TowerDataFolder
                    or (tonumber(t:GetAttribute("Upgrade")) or 0) > before
            end, 1, 0.03)
            if t.Parent ~= TowerDataFolder then return true end
            if (tonumber(t:GetAttribute("Upgrade")) or 0) >= target then return true end
            humanDelay(ok and 0.05 or 0.18, 0.03)
        else
            humanDelay(0.12, 0.05)
        end
    end
    return true
end

local function playSell(action)
    local t = resolveH(action.Handle)
    if not t then return true end
    for _ = 1, 3 do
        if not State.Playing or t.Parent ~= TowerDataFolder then return true end
        if Remotes.Sell then pcall(function() Remotes.Sell:FireServer(tostring(t.Name)) end) end
        if waitUntil(function() return t.Parent ~= TowerDataFolder end, 3, 0.1) then return true end
        humanDelay(0.9, 0.4)
    end
    return true
end

local function playTarget(action)
    local t = resolveH(action.Handle)
    if not t then return true end
    for _ = 1, 8 do
        if not State.Playing or t.Parent ~= TowerDataFolder then return true end
        if t:GetAttribute("TargetMode") == action.Mode then return true end
        if Remotes.Target then pcall(function() Remotes.Target:FireServer(tostring(t.Name)) end) end
        humanDelay(0.22, 0.08)
    end
    return true
end

local function findAbilityButtonForTower(towerId, abilityIndex)
    local gui = getGui()
    if not gui then return nil end
    local candidates = {}
    for _, o in ipairs(gui:GetDescendants()) do
        if o:IsA("GuiButton") and isAbilityButton(o) then
            local idx = inferAbilityIndex(o)
            local btnTower = o:GetAttribute("TowerId")
            if btnTower == nil or tostring(btnTower) == tostring(towerId) then
                table.insert(candidates, { btn = o, idx = idx })
            end
        end
    end
    if #candidates == 0 then return nil end
    for _, c in ipairs(candidates) do
        if c.idx == abilityIndex then return c.btn end
    end
    return candidates[1].btn
end

local function playAbility(action)
    local t = resolveH(action.Handle)
    if not t and action.Unit then
        for _, child in ipairs(TowerDataFolder:GetChildren()) do
            if own(child) and tostring(child:GetAttribute("ID")) == tostring(action.Unit) then
                t = child; break
            end
        end
    end
    if not t and action.TowerId then
        t = TowerDataFolder:FindFirstChild(tostring(action.TowerId))
    end
    if not t then
        t = findSelectedTower()
    end

    local towerId
    if t then
        local attrId = t:GetAttribute("ID")
        if attrId ~= nil then
            towerId = tostring(attrId)
        else
            towerId = tostring(t.Name)
        end
    elseif action.TowerId then
        towerId = tostring(action.TowerId)
    end

    local idx = tonumber(action.AbilityIndex) or 1

    if not towerId then
        return true, "no tower for ability"
    end

    humanDelay(0.3, 0.15)

    local remoteOk = false
    if Remotes.Ability then
        if Remotes.Ability:IsA("RemoteEvent") then
            remoteOk = pcall(function() Remotes.Ability:FireServer(towerId, idx) end)
        elseif Remotes.Ability:IsA("RemoteFunction") then
            remoteOk = pcall(function() Remotes.Ability:InvokeServer(towerId, idx) end)
        end
    end

    humanDelay(0.12, 0.06)


    local shouldClick = (not remoteOk) or t ~= nil
    if shouldClick then
        local btn = findAbilityButtonForTower(towerId, idx)
        if btn then
            if type(firesignal) == "function" then
                pcall(firesignal, btn.MouseButton1Click)
            elseif type(getconnections) == "function" then
                local ok, conns = pcall(getconnections, btn.MouseButton1Click)
                if ok and type(conns) == "table" then
                    for _, c in ipairs(conns) do
                        pcall(function()
                            if type(c.Fire) == "function" then c:Fire()
                            elseif type(c.Function) == "function" then c.Function() end
                        end)
                    end
                end
            end
            humanDelay(0.1, 0.05)
        end
    end

    return true
end

local function playBoost(action)
    local src = resolveH(action.SourceHandle)
    local tgt = resolveH(action.TargetHandle)
    if not src or not tgt then return true end
    if not Remotes.BoostSelect or not Remotes.BoostSelect:IsA("RemoteEvent") then return true end
    local sid = tonumber(src.Name)
    if not sid then return true end
    if tostring(tgt:GetAttribute("ClockBoost")) == tostring(sid) then return true end
    pcall(function() Remotes.BoostSelect:FireServer(sid, tostring(tgt.Name)) end)
    waitUntil(function()
        return not State.Playing
            or src.Parent ~= TowerDataFolder
            or tgt.Parent ~= TowerDataFolder
            or tostring(tgt:GetAttribute("ClockBoost")) == tostring(sid)
    end, 5, 0.05)
    humanDelay(0.15, 0.05)
    return true
end

local function waitGate(action, startedAt)
    local rt = tonumber(action.RecordedAt) or 0
    local cost = tonumber(action.EstimatedCost) or 0
    local wv = tonumber(action.Wave) or 0
    return waitUntil(function()
        if not State.Playing or gameEnded() then return true end
        local el = os.clock() - startedAt
        local hasT = el >= rt
        local hasM = cost <= 0 or getMoney() >= cost
        local hasW = wv <= 0 or getWave() >= wv
        if State.PlaybackMode == "Time" then return hasT end
        if State.PlaybackMode == "Money" then return hasM end
        if wv > 0 and getWave() > wv then hasT = true end
        return hasW and hasT and hasM
    end, 600, rand(0.05, 0.12))
end

local function stopPlayback(reason)
    State.Playing = false
    State.PlaybackSession = State.PlaybackSession + 1
end

local function startPlayback()
    if State.Recording then return false, "stop recording first" end
    if not matchReady() then return false, "enter match first" end
    if State.Playing then return false, "already playing" end
    if #State.Actions == 0 then return false, "no actions" end

    State.Playing = true
    State.AutoPlaybackStarted = true
    State.PlaybackFirstActionArmed = false
    State.RuntimeHandles = {}
    State.UsedRuntimeTowers = setmetatable({}, { __mode = "k" })
    State.PlaybackSession = State.PlaybackSession + 1
    local session = State.PlaybackSession

    task.spawn(function()
        local startedAt = os.clock()
        while State.Playing and session == State.PlaybackSession
            and not gameEnded() and getWave() < 1 do
            startedAt = os.clock()
            humanDelay(0.06, 0.02)
        end

        for i, a in ipairs(State.Actions) do
            if not State.Playing or session ~= State.PlaybackSession or gameEnded() then break end
            if i == 1 then State.PlaybackFirstActionArmed = true end
            if not waitGate(a, startedAt) then break end

            local ok = true
            if a.Type == "Place" then ok = playPlace(a)
            elseif a.Type == "Upgrade" then ok = playUpgrade(a)
            elseif a.Type == "Sell" then ok = playSell(a)
            elseif a.Type == "Target" then ok = playTarget(a)
            elseif a.Type == "Ability" then ok = playAbility(a)
            elseif a.Type == "BoostLink" then ok = playBoost(a)
            end
            if not ok then break end
        end

        if session == State.PlaybackSession then
            State.Playing = false
        end
    end)
    return true
end


local function startPlayerRec(name)
    if State.Playing then return false, "stop playback first" end
    name = sanitize(name)
    if name == "" then return false, "empty" end

    State.PlayerActions = {}
    State.PlayerRecordingProfileName = name
    State.PlayerRecordingStartedAt = os.clock()
    State.PlayerRecording = true
    State.PlayerRecordingConnections = {}

    local function stamp() return os.clock() - State.PlayerRecordingStartedAt end
    local function push(a)
        if not State.PlayerRecording then return end
        a.Wave = a.Wave or getWave()
        a.RecordedAt = stamp()
        table.insert(State.PlayerActions, a)
    end

    addConn(State.PlayerRecordingConnections, TowerDataFolder.ChildAdded:Connect(function(t)
        task.spawn(function()
            if not waitUntil(function() return own(t) and t:GetAttribute("ID") ~= nil end, 5, 0.05) then return end
            if not State.PlayerRecording then return end

            local placeHandle = "P" .. (#State.PlayerActions + 1)
            local cf = placeCF(t)
            if cf then
                local sell = tonumber(t:GetAttribute("SellPrice")) or 0
                push({ Type = "Place", Handle = placeHandle, Unit = tostring(t:GetAttribute("ID")),
                    CFrame = cframeToArray(cf), EstimatedCost = sell * 2 })
            end

            local m = {
                Handle = placeHandle,
                Level = tonumber(t:GetAttribute("Upgrade")) or 0,
                Sell = tonumber(t:GetAttribute("SellPrice")) or 0,
                PendCost = nil,
                TargetMode = t:GetAttribute("TargetMode"),
                LastUp = -math.huge,
                AbilityMarkers = {},
                ClockBoost = t:GetAttribute("ClockBoost"),
            }
            for a, v in pairs(t:GetAttributes()) do
                if tostring(a):match("^ATTACK") then m.AbilityMarkers[a] = v end
            end

            local rmConn
            local up = t:GetAttributeChangedSignal("SellPrice"):Connect(function()
                local np = tonumber(t:GetAttribute("SellPrice")) or m.Sell
                if np > m.Sell then
                    m.PendCost = math.max(0, (np - m.Sell) * 2)
                    m.LastUp = os.clock()
                end
                m.Sell = np
            end)
            local lv = t:GetAttributeChangedSignal("Upgrade"):Connect(function()
                if not State.PlayerRecording then return end
                local nl = tonumber(t:GetAttribute("Upgrade")) or m.Level
                if nl > m.Level then
                    push({ Type = "Upgrade", Handle = m.Handle, Unit = tostring(t:GetAttribute("ID")),
                        FromLevel = m.Level, ToLevel = nl, EstimatedCost = m.PendCost or 0 })
                end
                m.Level = nl
                m.PendCost = nil
            end)
            local tg = t:GetAttributeChangedSignal("TargetMode"):Connect(function()
                if not State.PlayerRecording then return end
                local nm = t:GetAttribute("TargetMode")
                if nm and nm ~= m.TargetMode and not badTarget(m.TargetMode) then
                    push({ Type = "Target", Handle = m.Handle, Mode = nm })
                end
                m.TargetMode = nm
            end)
            local bs = t:GetAttributeChangedSignal("ClockBoost"):Connect(function()
                if not State.PlayerRecording then return end
                local ns = t:GetAttribute("ClockBoost")
                if ns and tostring(ns) ~= "" and tostring(ns) ~= "0"
                    and tostring(ns) ~= tostring(m.ClockBoost) then
                    local src = TowerDataFolder:FindFirstChild(tostring(ns))
                    push({ Type = "BoostLink",
                        SourceUnit = src and tostring(src:GetAttribute("ID")) or tostring(ns),
                        TargetUnit = tostring(t:GetAttribute("ID")) })
                end
                m.ClockBoost = ns
            end)
            local ab = t.AttributeChanged:Connect(function(attr)
                if not State.PlayerRecording or not tostring(attr):match("^ATTACK") then return end
                local prev = m.AbilityMarkers[attr]
                local val = t:GetAttribute(attr)
                m.AbilityMarkers[attr] = val
                if prev == val then return end
                local idx = tonumber(tostring(attr):match("(%d+)$")) or 1
                local attrId = t:GetAttribute("ID")
                push({ Type = "Ability", Handle = m.Handle,
                    TowerId = tostring(t.Name),
                    Unit = attrId and tostring(attrId) or tostring(t:GetAttribute("ID")),
                    AbilityIndex = idx })
            end)
            rmConn = TowerDataFolder.ChildRemoved:Connect(function(c)
                if c ~= t or not State.PlayerRecording then return end
                push({ Type = "Sell", Handle = m.Handle, Unit = tostring(t:GetAttribute("ID")) })
                for _, conn in ipairs({ up, lv, tg, bs, ab, rmConn }) do
                    pcall(function() conn:Disconnect() end)
                end
            end)
            addConn(State.PlayerRecordingConnections, rmConn)
        end)
    end))

    if Remotes.Speed then
        addConn(State.PlayerRecordingConnections, Remotes.Speed.OnClientEvent:Connect(function(sp)
            if not State.PlayerRecording then return end
            push({ Type = "Speed", Speed = tonumber(sp) or 1 })
        end))
    end

    local gui = getGui()
    if gui then
        local function watchSkip(o)
            if not o:IsA("GuiButton") then return end
            if not tostring(o.Name):lower():find("skip") then return end
            addConn(State.PlayerRecordingConnections, o.MouseButton1Click:Connect(function()
                if not State.PlayerRecording then return end
                push({ Type = "Skip" })
            end))
        end
        for _, o in ipairs(gui:GetDescendants()) do watchSkip(o) end
        addConn(State.PlayerRecordingConnections, gui.DescendantAdded:Connect(watchSkip))
    end
    return true
end

local function stopPlayerRec(save)
    if not State.PlayerRecording then return false, "not recording" end
    State.PlayerRecording = false
    for _, c in ipairs(State.PlayerRecordingConnections or {}) do
        pcall(function() c:Disconnect() end)
    end
