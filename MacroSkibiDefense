        elseif a.Type == "Ability" then subj = "Ability #" .. tostring(a.AbilityIndex or 1)
        elseif a.Type == "BoostLink" then subj = string.format("%s > %s", a.SourceUnit or "?", a.TargetUnit or "?")
        elseif a.Type == "Skip" then subj = "skip" end
        lines[#lines + 1] = string.format("%02d | t%.2f | W%s | %s | %s",
            i, a.RecordedAt or 0, a.Wave or 0, a.Type or "?", subj)
    end
    playerSummary:SetTitle(string.format("Recorded: %d", #State.PlayerActions))
    playerSummary:SetDesc(#lines > 0 and table.concat(lines, "\n") or "None")
end

