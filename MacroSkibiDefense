local function tryFireBackButton(btn)
    if not btn or not btn.Parent then return false end
    if type(firesignal) == "function" then
        if pcall(firesignal, btn.MouseButton1Click) then return true end
    end
    if type(getconnections) == "function" then
        local ok, conns = pcall(getconnections, btn.MouseButton1Click)
        if ok and type(conns) == "table" then
            for _, c in ipairs(conns) do
                local fired = pcall(function()
                    if type(c.Fire) == "function" then c:Fire()
                    elseif type(c.Function) == "function" then c.Function() end
                end)
                if fired then return true end
            end
        end
    end
    if type(btn.Activate) == "function" then
        if pcall(function() btn:Activate() end) then return true end
    end
    if type(VirtualUser) == "table" and type(VirtualUser.MouseButton1Click) == "function" then
        local pos = btn.AbsolutePosition + btn.AbsoluteSize * 0.5
        if pcall(function() VirtualUser:MouseButton1Click(pos.X, pos.Y) end) then return true end
    end
    return false
end

local function forceReturnToLobby()
    if not State.PendingLobbyReturn then return false end
    local startJob = game.JobId
    local deadline = os.clock() + 20

    while State.Running and State.PendingLobbyReturn
        and os.clock() < deadline and game.JobId == startJob do
        local btn = getBackButton()
        if btn and btn.Visible then
            tryFireBackButton(btn)
        end
        humanDelay(0.5, 0.25)
    end

    local changed = game.JobId ~= startJob
    if changed then
        State.PendingLobbyReturn = false
        State.MatchesCompleted = 0
        State.LastCountedJobId = ""
        saveConfig()
    end
    return changed
end


local MOVE_POINTS = 12

local function getChar()
    local c = LocalPlayer.Character
    if not c then return nil, nil end
    local r = c:FindFirstChild("HumanoidRootPart")
    local h = c:FindFirstChildOfClass("Humanoid")
    if not r or not h or h.Health <= 0 then return nil, nil end
    return r, h
end

local function stopMove()
    local r, h = getChar()
    if r and h then
        h.AutoRotate = true
        h:MoveTo(r.Position)
    end
end

local function jump(h)
    if not h or h.Health <= 0 then return end
    pcall(function()
        h.Jump = true
        h:ChangeState(Enum.HumanoidStateType.Jumping)
    end)
end

local function getMapBounds()
    local map = Workspace:FindFirstChild("Map")
    if not map or not map:IsA("Model") then return nil, nil end
    local ok, cf, sz = pcall(function() return map:GetBoundingBox() end)
    if not ok or sz.X <= 0 or sz.Z <= 0 then return nil, nil end
    return cf.Position, sz
end

local function getGround(map, center, size, x, z)
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Include
    rp.FilterDescendantsInstances = { map }
    rp.IgnoreWater = true
    local origin = Vector3.new(x, center.Y + size.Y * 0.5 + 100, z)
    local res = Workspace:Raycast(origin, Vector3.new(0, -(size.Y + 300), 0), rp)
    if not res or res.Normal.Y < 0.6 then return nil end
    return res.Position
end

local function walkTo(session, dest)
    local r, h = getChar()
    if not r or not h then return false end
    local path = PathfindingService:CreatePath({
        AgentRadius = 2, AgentHeight = 5, AgentCanJump = true,
        AgentCanClimb = true, WaypointSpacing = 8,
    })
    local ok = pcall(function() path:ComputeAsync(r.Position, dest) end)
    if not ok or path.Status ~= Enum.PathStatus.Success then return false end
    local wps = path:GetWaypoints()
    if #wps < 2 then return false end

    for _, wp in ipairs(wps) do
        if not State.Running or not State.MovingAround or session ~= State.MovingSession then return false end
        r, h = getChar()
        if not r or not h then return false end

        if wp.Action == Enum.PathWaypointAction.Jump or wp.Position.Y > r.Position.Y + 1.5 then
            jump(h)
            humanDelay(0.025, 0.015)
        end

        local done = nil
        local conn = h.MoveToFinished:Connect(function(reached) done = reached == true end)
        local jitter = Vector3.new(rand(-0.6, 0.6), 0, rand(-0.6, 0.6))
        h:MoveTo(wp.Position + jitter)

        local startT = os.clock()
        local lastProg = startT
        local lastJmp = 0
        local best = (r.Position - wp.Position).Magnitude

        while done == nil and State.Running and State.MovingAround and session == State.MovingSession do
            humanDelay(0.05, 0.02)
            r, h = getChar()
            if not r or not h then break end
            local cur = (r.Position - wp.Position).Magnitude
            if cur <= best - 0.5 then
                best = cur; lastProg = os.clock()
            elseif os.clock() - lastProg >= 0.8 and os.clock() - lastJmp >= 0.8 then
                jump(h); lastJmp = os.clock()
            end
            if os.clock() - startT >= 8 then break end
        end
        conn:Disconnect()
        if not r or (r.Position - wp.Position).Magnitude > 4 then return false end
    end
    return true
end

local function moveLoop(session)
    while State.Running and State.MovingAround and session == State.MovingSession do
        local r, h = getChar()
        local c, s = getMapBounds()
        local map = Workspace:FindFirstChild("Map")
        if not r or not h or not c or not s or not map then
            humanDelay(1.0, 0.4)
        else
            h.AutoRotate = true
            local scales = { 0.42, 0.34, 0.26, 0.18, 0.10 }
            local bx = math.max(s.X, 25)
            local bz = math.max(s.Z, 25)
            local rel = r.Position - c
            local ang0 = math.atan2(rel.Z / bz, rel.X / bx)

            for i = 1, MOVE_POINTS do
                if not State.Running or not State.MovingAround or session ~= State.MovingSession then break end
                local ang = ang0 + (math.pi * 2 * i) / MOVE_POINTS + rand(-0.4, 0.4)
                humanDelay(0.18, 0.1)
                r, h = getChar()
                if not r or not h then break end
                local walked = false
                for _, sc in ipairs(scales) do
                    local tgt = getGround(map, c, s,
                        c.X + math.cos(ang) * bx * sc,
                        c.Z + math.sin(ang) * bz * sc)
                    if tgt and walkTo(session, tgt) then walked = true; break end
                end
                if not walked then humanDelay(0.35, 0.2) end
            end

            local cam = Workspace.CurrentCamera
            if cam then
                cam.CFrame = cam.CFrame * CFrame.Angles(
                    math.rad(rand(-2, 2)),
                    math.rad(rand(-12, 12)),
                    0)
            end
        end
    end
end

local function setMoving(on)
    State.MovingSession = State.MovingSession + 1
    local s = State.MovingSession
    stopMove()
    State.MovingAround = on == true
    if State.MovingAround then
        task.spawn(function() moveLoop(s) end)
    end
end

addConn(State.Connections, LocalPlayer.CharacterAdded:Connect(function()
    if not State.MovingAround then return end
    State.MovingSession = State.MovingSession + 1
    local s = State.MovingSession
    task.delay(0.6, function()
        if State.MovingAround and s == State.MovingSession then
            task.spawn(function() moveLoop(s) end)
        end
    end)
end))


local function httpPost(url, body)
    local requesters = {
        { name = "syn.request",    fn = syn and syn.request },
        { name = "http.request",   fn = http and http.request },
        { name = "http_request",   fn = http_request },
        { name = "request",        fn = request },
        { name = "fluxus.request", fn = fluxus and fluxus.request },
        { name = "krnl.request",   fn = krnl and krnl.request },
        { name = "game:HttpPost",  fn = game and game.HttpPost and function(opts)
            return game:HttpPost(opts.Url, opts.Body, "application/json")
        end },
    }

    for _, req in ipairs(requesters) do
        if type(req.fn) == "function" then
            local success, response = pcall(function()
                return req.fn({
                    Url = url,
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = body,
                })
            end)

            if success then
                if type(response) == "table" then
                    local code = response.StatusCode or response.status or response.Status
                    if code then
                        if code >= 200 and code < 300 then
                            print("[Webhook] " .. req.name .. " OK (" .. tostring(code) .. ")")
                            return true, req.name
                        else
                            warn("[Webhook] " .. req.name .. " HTTP " .. tostring(code) .. " - " .. tostring(response.StatusMessage or ""))
                        end
                    else
                        print("[Webhook] " .. req.name .. " OK (no status)")
                        return true, req.name
                    end
                else
                    print("[Webhook] " .. req.name .. " OK (raw)")
                    return true, req.name
                end
            else
                warn("[Webhook] " .. req.name .. " failed: " .. tostring(response))
            end
        end
    end
    return false, "all methods failed"
end

local function isValidWebhook(url)
    url = tostring(url or "")
    return url:match("^https://discord%.com/api/webhooks/") ~= nil
        or url:match("^https://discordapp%.com/api/webhooks/") ~= nil
end

local function sendWebhook(title, desc, color)
    if not State.WebhookEnabled then return false, "Webhook disabled" end
    if not isValidWebhook(State.WebhookURL) then return false, "URL not a Discord webhook" end
    local payload = {
        username = "Skibidi Defense Hub",
        embeds = {{
            title = tostring(title or "Hub"),
            description = tostring(desc or ""),
            color = tonumber(color) or 5793266,
            footer = { text = "Made By oreshick :3" },
            timestamp = DateTime.now():ToIsoDate(),
        }},
    }
    local ok, enc = pcall(function() return HttpService:JSONEncode(payload) end)
    if not ok then return false, "JSON encode: " .. tostring(enc) end
    return httpPost(State.WebhookURL, enc)
end

local function sendMatchEndWebhook()
    if not State.WebhookEnabled or not State.WebhookMatchEnd then return end
    if not isValidWebhook(State.WebhookURL) then return end

    local res = getMatchResult()
    local color = (res == "Victory") and 65280 or 16711680
    local stage = tostring(State.LobbyChapter) .. " (" .. tostring(State.LobbyMode) .. ")"

    local payload = {
        username = "Skibidi Defense Hub",
        embeds = {{
            title = "Match Report",
            description = string.format("**Stage:** %s\n**Result:** %s", stage, res),
            color = color,
            fields = {
                { name = "Player",
                  value = string.format("Name: ||%s||\nMoney: %s\nBase HP: %s",
                    LocalPlayer.Name, tostring(getMoney()), tostring(getBaseHp())),
                  inline = false },
                { name = "Match",
                  value = string.format("Wave: %s\nMacro: %s\nCycle: %d/%d",
                    tostring(getWave()),
                    (State.ProfileName ~= "" and State.ProfileName or "None"),
                    State.MatchesCompleted, State.MatchesBeforeLobby),
                  inline = false },
            },
            footer = { text = "Made By oreshick :3" },
            timestamp = DateTime.now():ToIsoDate(),
        }},
    }
    local ok, enc = pcall(function() return HttpService:JSONEncode(payload) end)
    if ok then pcall(httpPost, State.WebhookURL, enc) end
end


local function saveProfile(name)
    name = sanitize(name)
    if name == "" then return false, "empty" end
    if not HAS_FS then return false, "no fs" end
    local payload = { Version = 4, PlaceId = game.PlaceId, Name = name, RecordedAt = os.time(), Actions = State.Actions }
    local ok, enc = pcall(HttpService.JSONEncode, HttpService, payload)
    if not ok then return false, enc end
    pcall(writefile, profilePath(name), enc)
    State.ProfileName = name
    State.ProfileVersion = 4
    return true
end

local function loadProfile(name)
    name = sanitize(name)
    if name == "" or not HAS_FS or not isfile(profilePath(name)) then return false, "not found" end
    local ok, dec = pcall(function() return HttpService:JSONDecode(readfile(profilePath(name))) end)
    if not ok or type(dec) ~= "table" or type(dec.Actions) ~= "table" then return false, "invalid" end
    State.ProfileName = name
    State.ProfileVersion = tonumber(dec.Version) or 1
    State.Actions = dec.Actions
    return true
end

