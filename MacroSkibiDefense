local function addConn(bucket, conn)
    if conn then table.insert(bucket, conn) end
    return conn
end

local function disconnectAll(bucket)
    if not bucket then return end
    for _, c in ipairs(bucket) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(bucket)
end

local function waitUntil(cond, timeout, interval)
    local deadline = os.clock() + (timeout or 5)
    interval = interval or 0.05
    repeat
        if not State.Running then return false end
        local ok, res = pcall(cond)
        if ok and res then return true, res end
        task.wait(interval)
    until os.clock() >= deadline
    return false
end


