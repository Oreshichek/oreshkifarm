local function humanizeMod(id)
    if ModSpecial[id] then return ModSpecial[id] end
    return id:gsub("(%l)(%u)", "%1 %2"):gsub("(%a)(%d)", "%1 %2"):gsub("(%d)(%a)", "%1 %2")
end
for _, id in ipairs(LobbyModifierIds) do
    ModSet[id] = true
    local d = string.format("%s [%s]", humanizeMod(id), id)
    DispToId[d] = id; IdToDisp[id] = d
    ModList[#ModList + 1] = d
end

local function normalizeMods(v)
    local s = {}
    if type(v) ~= "table" then return s end
    for k, val in pairs(v) do
        local nm
        if type(k) == "string" and val == true then nm = k
        elseif type(k) == "number" and type(val) == "string" then nm = val end
        local id = nm and (DispToId[nm] or nm)
        if id and ModSet[id] then s[id] = true end
    end
    return s
end
