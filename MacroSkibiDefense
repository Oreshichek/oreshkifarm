function Hub.Destroy()
    State.Running = false
    State.MasterSession         = State.MasterSession + 1
    State.MovingSession         = State.MovingSession + 1
    State.AutomationSession     = State.AutomationSession + 1
    State.PlaybackSession       = State.PlaybackSession + 1
    State.PlayerPlaybackSession = State.PlayerPlaybackSession + 1
    State.RecordSession         = State.RecordSession + 1
    State.UISession             = State.UISession + 1

    State.Recording = false
    State.Playing = false
    State.PlayerRecording = false
    State.MovingAround = false

    stopMove()
    saveConfig()
    disconnectAll(State.RecorderConnections)
    disconnectAll(State.PlayerRecordingConnections)
    disconnectAll(State.Connections)

    pcall(function() Window:Destroy() end)
    if Environment.SkibidiDefenseHub == Hub then
        Environment.SkibidiDefenseHub = nil
    end
end

