local playerPlayToggle
playerPlayToggle = safeToggle(PlayerTab, {
    Title = "Playback", Value = false,
    Callback = function(v)
        if changingPlayerToggle then return end
        if v then
            if State.PlayerRecording then
                setPlayerToggle(playerRecToggle, false)
                stopPlayerRec(true)
            end
            local profileName = playerDropdown and playerDropdown.Value or ""
            local path = playerProfilePath(profileName)
            if HAS_FS and isfile(path) then
                local ok, dec = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
                if ok and dec and type(dec.Actions) == "table" then
                    State.PlayerActions = dec.Actions
                end
            end
            if #State.PlayerActions == 0 then
                setPlayerToggle(playerPlayToggle, false)
                notify("Cannot play", "No actions")
                return
            end

            State.Playing = true
            State.RuntimeHandles = {}
            State.UsedRuntimeTowers = setmetatable({}, { __mode = "k" })
            State.PlayerPlaybackSession = State.PlayerPlaybackSession + 1
            local sess = State.PlayerPlaybackSession

            task.spawn(function()
                local startedAt = os.clock()
                for _, a in ipairs(State.PlayerActions) do
                    if not State.Playing or sess ~= State.PlayerPlaybackSession then break end
                    local target = tonumber(a.RecordedAt) or 0
                    while (os.clock() - startedAt) < target and State.Playing and sess == State.PlayerPlaybackSession do
                        humanDelay(0.06, 0.02)
                    end
                    if not State.Playing or sess ~= State.PlayerPlaybackSession then break end

                    if a.Type == "Place" then
                        local cf = arrayToCFrame(a.CFrame)
                        if cf and getMoney() >= (tonumber(a.EstimatedCost) or 0) and Remotes.Place then
                            pcall(function() Remotes.Place:FireServer(a.Unit, cf, false) end)
                            humanDelay(0.35, 0.1)
                        end
                    elseif a.Type == "Upgrade" then
                        local t = findRuntime(a)
                        if t and Remotes.Upgrade then
                            for _ = 1, 6 do
                                if not State.Playing then break end
                                if (tonumber(t:GetAttribute("Upgrade")) or 0) >= (tonumber(a.ToLevel) or 1) then break end
                                pcall(function() Remotes.Upgrade:FireServer(tostring(t.Name)) end)
                                humanDelay(0.2, 0.05)
                            end
                        end
                    elseif a.Type == "Sell" then
                        local t = findRuntime(a)
                        if t and Remotes.Sell then pcall(function() Remotes.Sell:FireServer(tostring(t.Name)) end) end
                        humanDelay(0.2, 0.05)
                    elseif a.Type == "Target" then
                        local t = findRuntime(a)
                        if t and Remotes.Target then pcall(function() Remotes.Target:FireServer(tostring(t.Name)) end) end
                        humanDelay(0.2, 0.05)
                    elseif a.Type == "Ability" then
                        local t = findRuntime(a)
                        local abilityId
                        if t then
                            local attrId = t:GetAttribute("ID")
                            abilityId = attrId and tostring(attrId) or tostring(t.Name)
                        elseif a.TowerId then
                            abilityId = tostring(a.TowerId)
                        end
                        if abilityId and Remotes.Ability then
                            local idx = tonumber(a.AbilityIndex) or 1
                            humanDelay(0.25, 0.1)
                            if Remotes.Ability:IsA("RemoteEvent") then
                                pcall(function() Remotes.Ability:FireServer(abilityId, idx) end)
                            elseif Remotes.Ability:IsA("RemoteFunction") then
                                pcall(function() Remotes.Ability:InvokeServer(abilityId, idx) end)
                            end
                            humanDelay(0.3, 0.1)
                        end
                    elseif a.Type == "BoostLink" then
                        local src = findRuntime({ Unit = a.SourceUnit })
                        local tgt = findRuntime({ Unit = a.TargetUnit })
                        if src and tgt and Remotes.BoostSelect then
                            pcall(function() Remotes.BoostSelect:FireServer(tonumber(src.Name), tostring(tgt.Name)) end)
                        end
                        humanDelay(0.2, 0.05)
                    elseif a.Type == "Speed" then
                        if Remotes.Speed then pcall(function() Remotes.Speed:FireServer(tonumber(a.Speed) or 1) end) end
                        humanDelay(0.15, 0.05)
                    elseif a.Type == "Skip" then
                        if Remotes.Skip then pcall(function() Remotes.Skip:FireServer(true) end) end
                        humanDelay(0.15, 0.05)
                    end
                end
                if sess == State.PlayerPlaybackSession then State.Playing = false end
            end)
        elseif State.Playing then
            stopPlayback("Stopped by user")
        end
    end,
})
