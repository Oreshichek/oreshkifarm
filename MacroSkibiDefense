local function getMatchResult()
    local ge = getGui() and getGui():FindFirstChild("GameEnded")
    if not ge then return "Match Ended" end
    for _, d in ipairs(ge:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            local t = string.lower(tostring(d.Text or ""))
            if t:find("victory", 1, true) or t:find("you won", 1, true)
                or t:find("you have defeated", 1, true) then
                return "Victory"
            end
        end
    end
    for _, d in ipairs(ge:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            local t = string.lower(tostring(d.Text or ""))
            if t:find("defeat", 1, true) or t:find("you lost", 1, true)
                or t:find("game over", 1, true) then
                return "Defeat"
            end
        end
    end
    return "Match Ended"
end


local function own(t)
    return t and t.Parent == TowerDataFolder and t:GetAttribute("Creator") == LocalPlayer.Name
end


local function findSelectedTower()
    if State.LastSelectedTower and State.LastSelectedTower.Parent == TowerDataFolder then
        return State.LastSelectedTower
    end
    if TowerDataFolder then
        for _, t in ipairs(TowerDataFolder:GetChildren()) do
            if own(t) and (t:GetAttribute("Selected") == true or t:GetAttribute("IsSelected") == true) then
                State.LastSelectedTower = t
                return t
            end
        end
    end
    if TowerDataFolder then
        for _, t in ipairs(TowerDataFolder:GetChildren()) do
            if own(t) then
                return t
            end
        end
    end
    return nil
end


local function isAbilityButton(obj)
    if not obj or not obj:IsA("GuiButton") then return false end
    local cur = obj
    for _ = 1, 4 do
        if not cur then break end
        local n = tostring(cur.Name):lower()
        if n:find("abilit", 1, true) or n:find("skill", 1, true) then return true end
        cur = cur.Parent
    end
    return false
end

local function inferAbilityIndex(obj)
    local cur = obj
    for _ = 1, 5 do
        if not cur then break end
        for _, attr in ipairs({ "AbilityIndex", "Ability", "Index", "Slot", "SlotIndex", "KeyIndex" }) do
            local v = tonumber(cur:GetAttribute(attr))
            if v and v >= 1 then return math.floor(v) end
        end
        local fromName = tonumber(tostring(cur.Name):match("(%d+)$"))
        if fromName and fromName >= 1 then return math.floor(fromName) end
        if cur:IsA("GuiObject") and cur.LayoutOrder > 0 then return cur.LayoutOrder end
        cur = cur.Parent
    end
    return 1
end

local abilityClickHookInstalled = false
local function installAbilityClickHook()
    if abilityClickHookInstalled then return end
    abilityClickHookInstalled = true

    local function hookButton(btn)
        if not isAbilityButton(btn) then return end
        if btn:GetAttribute("__SkibidiHooked") then return end
        btn:SetAttribute("__SkibidiHooked", true)

        local conn
        conn = btn.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
                and input.UserInputType ~= Enum.UserInputType.Touch then return end

            local idx = inferAbilityIndex(btn)
            local tower = findSelectedTower()
            local towerId = tower and tostring(tower.Name) or nil
            local unitId  = tower and tostring(tower:GetAttribute("ID")) or nil

            State.PendingAbilityClickAt = os.clock()
            State.PendingAbilityIndex = idx

            if not State.Recording and not State.PlayerRecording then return end
            local meta = tower and State.TowerMeta[tower]
            local handle = meta and meta.Handle or (towerId or "Global")

            local action = {
                Type = "Ability",
                Handle = handle,
                TowerId = towerId,       
                Unit = unitId,
                AbilityIndex = idx,
                Wave = getWave(),
                RecordedAt = os.clock() - (State.RecordStartedAt or 0),
            }

            if State.Recording then
                local last = State.Actions[#State.Actions]
                if last and last.Type == "Ability"
                    and last.Marker == tostring(btn)
                    and os.clock() - State.PendingAbilityClickAt <= 0.35 then
                    last.AbilityIndex = idx
                else
                    action.Marker = tostring(btn)
                    table.insert(State.Actions, action)
                end
            end
            if State.PlayerRecording then
                local action2 = {}
                for k, v in pairs(action) do action2[k] = v end
                action2.RecordedAt = os.clock() - State.PlayerRecordingStartedAt
                table.insert(State.PlayerActions, action2)
            end
        end)
        addConn(State.Connections, conn)
    end

    local gui = getGui()
    if gui then
        for _, o in ipairs(gui:GetDescendants()) do hookButton(o) end
        addConn(State.Connections, gui.DescendantAdded:Connect(hookButton))
    end
end

task.spawn(installAbilityClickHook)

