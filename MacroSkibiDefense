State.AutomationSession = State.AutomationSession + 1
local automationSession = State.AutomationSession

task.spawn(function()
    local lastReady, lastSkip = 0, 0
    local speedReadySince
    local lastRefresh = 0
    local wasReady = false
    local startupSpeedReset = false
    local replayLatched = false
    local restartAfterReplay = false

    while State.Running and automationSession == State.AutomationSession do
        local now = os.clock()
        if now - lastRefresh >= 10 then
            lastRefresh = now
            refreshObjects()
        end

        local ended = gameEnded()
        local mr = TowerDataFolder ~= nil and TowersFolder ~= nil and Remotes.Place ~= nil
        local macroCfg = State.PlaybackEnabled and State.ProfileName ~= ""
        local macroPrep = not macroCfg or #State.Actions > 0
        local macroAuto = macroPrep and (not macroCfg or State.PlaybackFirstActionArmed)

        if not mr or ended then
            State.AutoPlaybackStarted = false
            State.PlaybackFirstActionArmed = false
            wasReady = false
            speedReadySince = nil
            startupSpeedReset = false
        elseif not wasReady then
            wasReady = true
            speedReadySince = nil
            startupSpeedReset = false
        elseif State.PlaybackEnabled and not State.AutoPlaybackStarted
            and not State.Playing and not State.Recording
            and #State.Actions > 0 and Gui.StartEnabledPlayback then
            Gui.StartEnabledPlayback()
        end

        if State.AutoReady and not ended and Remotes.Ready and now - lastReady >= 1 then
            lastReady = now
            pcall(function() Remotes.Ready:FireServer(true) end)
        end

        if mr and macroPrep and not macroAuto
            and (State.AutoSpeed or State.AutoSkip) and Remotes.Speed and not startupSpeedReset then
            startupSpeedReset = true
            pcall(function() Remotes.Speed:FireServer(1) end)
        end

        local gui = getGui()
        local skipGui = gui and gui:FindFirstChild("skipWave")
        local skipOpen = skipGui and skipGui.Enabled == true
        if State.AutoSkip and macroAuto and not ended and Remotes.Skip
            and skipOpen and now - lastSkip >= rand(0.3, 0.5) then
            lastSkip = now
            pcall(function() Remotes.Skip:FireServer(true) end)
        end

        local speedOk = State.AutoSpeed and macroAuto and mr and Remotes.Speed and not ended
        if speedOk then
            if speedReadySince == nil then speedReadySince = now
            elseif now - speedReadySince >= State.SpeedScaleDelay then
                speedReadySince = now
                pcall(function() Remotes.Speed:FireServer(State.Speed) end)
            end
        else
            speedReadySince = nil
        end

        if ended and not replayLatched then
            replayLatched = true
            if State.AutoBackLobby and State.LastCountedJobId ~= game.JobId then
                State.LastCountedJobId = game.JobId
                State.MatchesCompleted = State.MatchesCompleted + 1
                if State.MatchesCompleted >= State.MatchesBeforeLobby then
                    State.PendingLobbyReturn = true
                    setStatus("Cycle complete", "Returning to lobby")
                    humanDelay(rand(1.5, 3.0), 0.5)
                else
                    setStatus("Match counted",
                        string.format("%d/%d", State.MatchesCompleted, State.MatchesBeforeLobby))
                end
                if Gui.UpdateMatchCounter then Gui.UpdateMatchCounter() end
                saveConfig()
            end

            sendMatchEndWebhook()

            if State.PendingLobbyReturn then
                task.spawn(function() forceReturnToLobby() end)
            end

            local shouldReplay = State.AutoReplay and not State.PendingLobbyReturn
            if shouldReplay and Remotes.Replay then
                restartAfterReplay = not State.PendingLobbyReturn
                    and State.PlaybackEnabled and #State.Actions > 0
                pcall(function() Remotes.Replay:FireServer() end)
            end
        elseif not ended then
            replayLatched = false
            if restartAfterReplay and not State.Playing then
                restartAfterReplay = false
                local ok, msg = startPlayback()
                if ok and Gui.SetPlaybackToggle then Gui.SetPlaybackToggle(true)
                elseif not ok then setStatus("Replay", tostring(msg)) end
            end
        end

        humanDelay(0.12, 0.05)
    end
end)

